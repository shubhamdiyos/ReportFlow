# Ignore node_modules
**/node_modules/

# Ignore git
.git
.gitignore

# Ignore documentation
*.md
!README.md

# Ignore test files
**/*_test.html
**/test_*.sh

# Ignore IDE files
.idea
.vscode
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Don't ignore report_backend (explicitly include it)
!report_backend/
